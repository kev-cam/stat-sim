.measure tran EB_C FIND V(xeb) AT=106.367943p
.measure tran EB_D FIND V(xeb) AT=494.367943p
.measure tran ESW_Z FIND V(xesw) AT=1.500000p
.measure tran ESW_B FIND V(xesw) AT=99.367943p
.measure tran ESW_C FIND V(xesw) AT=106.367943p
.measure tran ESW_D FIND V(xesw) AT=494.367943p
