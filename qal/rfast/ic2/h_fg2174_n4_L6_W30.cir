.measure tran EBK_B FIND V(xebk) AT=99.367943p
.measure tran EBK_C FIND V(xebk) AT=106.367943p
.measure tran EBK_D FIND V(xebk) AT=494.367943p
.measure tran QGT_Z FIND V(xqgt) AT=1.500000p
.measure tran QGT_B FIND V(xqgt) AT=99.367943p
.measure tran QGT_C FIND V(xqgt) AT=106.367943p
.measure tran QGT_D FIND V(xqgt) AT=494.367943p
