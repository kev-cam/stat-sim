read_verilog /usr/local/src/stat-sim/qal/synth/threeway/sha_slice.v
rename sha_slice gold
prep -flatten -top gold
design -stash gold
read_verilog /usr/local/src/stat-sim/qal/sha256/verify/cells_min.v
read_verilog syn/sha_slice.shallow.v
rename sha_slice gate
prep -flatten -top gate
