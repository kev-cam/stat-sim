read_verilog /usr/local/src/stat-sim/qal/synth/threeway/sha_slice.v
rename sha_slice gold
prep -flatten -top gold
design -stash gold
read_verilog /usr/local/src/stat-sim/qal/sha256/verify/cells_min.v
read_verilog syn/sw_nand_sc_resyn2.v
rename sha_slice gate
prep -flatten -top gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
flatten; opt -full
sat -verify -prove-asserts -show-ports miter
