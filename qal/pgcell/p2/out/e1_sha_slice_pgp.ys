read_verilog /usr/local/src/stat-sim/qal/synth/threeway/sha_slice.v
rename sha_slice gold
prep -flatten -top gold
design -stash gold
read_verilog /usr/local/src/stat-sim/qal/pgcell/p2/minicells.v
read_verilog /usr/local/src/stat-sim/qal/pgcell/p2/pgcells.v
read_verilog out/sha_slice.pgp.v
rename sha_slice gate
prep -flatten -top gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
flatten
opt -full
sat -verify -prove-asserts -show-ports miter
