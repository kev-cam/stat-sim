.hdl "/usr/local/share/xyce/verilog-a/psp103/psp103.va"
.include "/usr/local/src/kestrel/sim/models/sg13g2_psp103_tt.lib"
.include "/usr/local/src/stat-sim/qal/sg13lv_compat.sp"
.OPTIONS TIMEINT METHOD=GEAR RELTOL=1e-6 ABSTOL=1e-15 CHGTOL=1e-17
.param LT=10n RS=10 CA=35.979f
CA bka 0 {CA}
VHI vhi 0 1.65
VGT  gt  0 PWL(0 0 48p 0 50p 1.65 104.194p 1.65 106.194p 0)
VGTP gtp 0 PWL(0 1.65 48p 1.65 50p 0 104.194p 0 106.194p 1.65)
XSWN sw gt bkb 0 sg13_lv_nmos w=10u l=0.13u
XSWP sw gtp bkb vhi sg13_lv_pmos w=20u l=0.13u
XPK sw pk 0 0 sg13_lv_nmos w=2u l=0.13u
VPK pk 0 PWL(0 0 106.194p 0 108.194p 1.65)
LT bka mid {LT}
RT mid sw {RS}
VMGH gnh 0 0
VMGL gnl 0 0
VI0 in0 0 1.65
XP0 o0 in0 bkb bkb sg13_lv_pmos w=1.12u l=0.13u
XN0 o0 in0 gnh gnh sg13_lv_nmos w=0.74u l=0.13u
CL0 o0 gnh 2f
VI1 in1 0 0
XP1 o1 in1 bkb bkb sg13_lv_pmos w=1.12u l=0.13u
XN1 o1 in1 gnl gnl sg13_lv_nmos w=0.74u l=0.13u
CL1 o1 gnl 2f
VI2 in2 0 1.65
XP2 o2 in2 bkb bkb sg13_lv_pmos w=1.12u l=0.13u
XN2 o2 in2 gnh gnh sg13_lv_nmos w=0.74u l=0.13u
CL2 o2 gnh 2f
VI3 in3 0 0
