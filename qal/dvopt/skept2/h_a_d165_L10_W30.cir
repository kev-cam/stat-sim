BXesl 0 xesl I={ V(bkb)*(I(VMGL)+I(VI1)+I(VI3)+I(VI5)+I(VI7)) }
RXesl xesl 0 0.01
CXqgh xqgh 0 1
BXqgh 0 xqgh I={ I(VMGH) }
RXqgh xqgh 0 0.01
CXqgl xqgl 0 1
BXqgl 0 xqgl I={ I(VMGL) }
RXqgl xqgl 0 0.01
CXqih xqih 0 1
BXqih 0 xqih I={ -(I(VI0)+I(VI2)+I(VI4)+I(VI6)) }
RXqih xqih 0 0.01
CXeih xeih 0 1
BXeih 0 xeih I={ -(V(in0)*I(VI0)+V(in2)*I(VI2)+V(in4)*I(VI4)+V(in6)*I(VI6)) }
RXeih xeih 0 0.01
CXqil xqil 0 1
BXqil 0 xqil I={ -(I(VI1)+I(VI3)+I(VI5)+I(VI7)) }
RXqil xqil 0 0.01
CXqlt xqlt 0 1
BXqlt 0 xqlt I={ I(LT) }
RXqlt xqlt 0 0.01
CXea xea 0 1
BXea 0 xea I={ V(bka)*I(LT) }
RXea xea 0 0.01
CXeb xeb 0 1
BXeb 0 xeb I={ V(bkb)*I(LT) }
RXeb xeb 0 0.01
CXqbk xqbk 0 1
BXqbk 0 xqbk I={ (I(VMGH)+I(VI0)+I(VI2)+I(VI4)+I(VI6))+(I(VMGL)+I(VI1)+I(VI3)+I(VI5)+I(VI7)) }
RXqbk xqbk 0 0.01
CXebk xebk 0 1
BXebk 0 xebk I={ V(bkb)*((I(VMGH)+I(VI0)+I(VI2)+I(VI4)+I(VI6))+(I(VMGL)+I(VI1)+I(VI3)+I(VI5)+I(VI7))) }
RXebk xebk 0 0.01
CXer xer 0 1
BXer 0 xer I={ I(LT)*I(LT)*10 }
RXer xer 0 0.01
CXesw xesw 0 1
BXesw 0 xesw I={ V(sw)*I(LT) }
RXesw xesw 0 0.01
CXqgt xqgt 0 1
BXqgt 0 xqgt I={ -I(VGT) }
RXqgt xqgt 0 0.01
CXqgtp xqgtp 0 1
BXqgtp 0 xqgtp I={ -I(VGTP) }
RXqgtp xqgtp 0 0.01
CXqhi xqhi 0 1
BXqhi 0 xqhi I={ -I(VHI) }
RXqhi xqhi 0 0.01
CXegt xegt 0 1
BXegt 0 xegt I={ -V(gt)*I(VGT)-V(gtp)*I(VGTP)-V(pk)*I(VPK) }
RXegt xegt 0 0.01
CXehi xehi 0 1
BXehi 0 xehi I={ -1.65*I(VHI) }
RXehi xehi 0 0.01
Bpa pa 0 V={ V(bka)*I(LT) }
Bpb pb 0 V={ V(bkb)*I(LT) }
Bqt qt 0 V={ I(LT) }
